{
  "manifest_version": 3,
  "name": "FlowMark",
  "version": "1.0.0",
  "description": "A fast, modern bookmark manager replacement.",
  "action": {
    "default_popup": "index.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+B",
        "mac": "Alt+B"
      },
      "description": "Open FlowMark"
    }
  },
  "permissions": [
    "bookmarks",
    "tabs",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "index.html?mode=sidebar"
  }
}